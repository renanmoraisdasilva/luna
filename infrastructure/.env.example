MSSQL_SA_PASSWORD=Your_password123
MSSQL_IMAGE_TAG=2022-CU26-ubuntu-22.04
LUNA_COOKIE_ENCRYPTION_KEY=replace-with-a-base64-encoded-32-byte-key
AUTH_COOKIE_SECURE=false
ORDERS_SERVICE_CLIENT_SECRET=replace-with-a-long-random-orders-client-secret
# Requests per minute per caller address to the Identity token endpoint. Raise it only if legitimate traffic
# is being refused; the default is deliberately low because this is the unauthenticated password-grant surface.
IDENTITY_TOKEN_REQUESTS_PER_MINUTE=10
IDENTITY_SIGNING_KEY_PASSWORD=replace-with-the-passphrase-for-the-signing-key
IDENTITY_SIGNING_KEY_PATH=/run/secrets/identity/signing.pfx
IDENTITY_ENCRYPTION_KEY_PASSWORD=replace-with-the-passphrase-for-the-encryption-key
IDENTITY_ENCRYPTION_KEY_PATH=/run/secrets/identity/encryption.pfx
TELEMETRY_ENABLED=true
TELEMETRY_ENVIRONMENT=Development
OTEL_EXPORTER_OTLP_ENDPOINT=http://host.docker.internal:4317
OTEL_EXPORTER_OTLP_HTTP_ENDPOINT=http://host.docker.internal:4318
