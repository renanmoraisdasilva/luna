MSSQL_SA_PASSWORD=Your_password123
MSSQL_IMAGE_TAG=2022-CU26-ubuntu-22.04
LUNA_COOKIE_ENCRYPTION_KEY=replace-with-a-base64-encoded-32-byte-key
AUTH_COOKIE_SECURE=false
ORDERS_SERVICE_CLIENT_SECRET=replace-with-a-long-random-orders-client-secret
IDENTITY_TOKEN_REQUESTS_PER_MINUTE=10
# Host directory holding signing.pfx and encryption.pfx. Must be outside the deploy checkout.
IDENTITY_KEY_DIRECTORY=/opt/luna/secrets/identity
TELEMETRY_ENABLED=true
TELEMETRY_ENVIRONMENT=Development
OTEL_EXPORTER_OTLP_ENDPOINT=http://host.docker.internal:4317
OTEL_EXPORTER_OTLP_HTTP_ENDPOINT=http://host.docker.internal:4318
