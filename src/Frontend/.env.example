# Browser code calls same-origin paths through the Next.js thin gateway.
# Example: /api/services/catalog/api/v1/products

# These are only needed when running Next.js outside Docker with the
# development Compose override. They are server-side rewrite destinations.
IDENTITY_API_INTERNAL_URL=http://localhost:5001
CATALOG_API_INTERNAL_URL=http://localhost:5002
ORDERS_API_INTERNAL_URL=http://localhost:5003
PAYMENTS_API_INTERNAL_URL=http://localhost:5004
INVENTORY_API_INTERNAL_URL=http://localhost:5005
SHIPPING_API_INTERNAL_URL=http://localhost:5006
